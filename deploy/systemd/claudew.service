[Unit]
Description=estate workers: run at most one queued task
Wants=network-online.target claudew-push.socket claudew-proxy.socket
Requires=claudew-egress.service
After=network-online.target claudew-push.socket claudew-proxy.socket claudew-egress.service
ConditionPathExists=!/etc/claudew/STOP

[Service]
Type=oneshot
User=claudew
Group=claudew
UMask=0027
# Skip the night window that belongs to the range agents and the backup.
ExecCondition=/bin/sh -c 'h=$(TZ=Europe/London date +%%H%%M); [ "$h" -lt 200 ] || [ "$h" -ge 430 ]'
ExecStart=/opt/claudew/bin/claudew -config /etc/claudew/config.json drain
LoadCredentialEncrypted=anthropic-workers:/etc/credstore.encrypted/anthropic-workers.cred

# A stop or a kill reaches claude as SIGINT first, so it can record its cost.
KillSignal=SIGINT
TimeoutStopSec=20s
TimeoutStartSec=50min

# No RestrictSUIDSGID: its filter answers openat2 with ENOSYS and the
# shell sandbox (bubblewrap) cannot open any path. NoNewPrivileges still
# stops a set-uid file from granting anything.
# No ProtectKernelTunables, ProtectKernelLogs or ProtectHostname either: each
# lays mounts over parts of /proc, and the kernel then refuses the fresh /proc
# bubblewrap mounts. This user cannot write /proc/sys, read /proc/kmsg or set
# the host name anyway.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/claudew /var/lib/prometheus/node-exporter/claudew.prom
ReadOnlyPaths=/etc/claudew
# The shell sandbox masks container runtime sockets, and bubblewrap cannot
# do that under /run/containerd (mode 0711) as this user. The service does
# not need containerd, so it sees an empty directory there.
TemporaryFileSystem=/run/containerd:ro

# A network namespace of its own with nothing but loopback: none of the
# host's services on 127.0.0.1 or ::1 is in it. The one door out is the
# egress proxy's unix socket (/run/claudew-proxy/proxy.sock), which a
# bridge in this process turns into HTTPS_PROXY for git, Go and claude.
PrivateNetwork=yes
IPAddressDeny=any
IPAddressAllow=localhost

CPUQuota=200%
MemoryMax=4G
TasksMax=512
Nice=10
IOSchedulingClass=idle
