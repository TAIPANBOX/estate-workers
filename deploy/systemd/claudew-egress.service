[Unit]
Description=estate workers: egress filter for the worker users (nftables table inet claudew)
After=nftables.service
Before=network-pre.target claudew.service claudew-push.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/claudew/egress.nft
ExecStop=/usr/sbin/nft delete table inet claudew

[Install]
WantedBy=multi-user.target
