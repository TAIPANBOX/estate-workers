[Unit]
Description=estate workers: push service socket

[Socket]
ListenStream=/run/claudew-push/push.sock
SocketUser=claudew-gh
SocketGroup=claudew
SocketMode=0660
# systemd creates this directory owned by root, not by SocketUser, so it
# must be traversable; the socket's mode and group decide who may connect.
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
